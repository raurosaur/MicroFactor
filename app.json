{
  "expo": {
    "name": "MicroFactor",
    "slug": "microfactor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "microfactor",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.raurosaur.microfactor"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.raurosaur.microfactor"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/logo.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/logo.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      "expo-image",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ab1e8948-bd5c-478a-8955-2bd77194dd21"
      }
    },
    "owner": "raurosaur"
  }
}
